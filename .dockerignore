# Explicit allowlist: no environment files, DB dumps, documents, logs, Git or host build output.
**
!Dockerfile
!.dockerignore
!deployment/
!deployment/docker/
!deployment/docker/Healthcheck.java
!auth-service/
!auth-service/pom.xml
!auth-service/src/
!auth-service/src/**
!academic-service/
!academic-service/pom.xml
!academic-service/src/
!academic-service/src/**
!teaching-service/
!teaching-service/pom.xml
!teaching-service/src/
!teaching-service/src/**
!finance-service/
!finance-service/pom.xml
!finance-service/src/
!finance-service/src/**
!api-gateway/
!api-gateway/pom.xml
!api-gateway/src/
!api-gateway/src/**
!assistant-service/
!assistant-service/pom.xml
!assistant-service/src/
!assistant-service/src/**
**/.env
**/.env.*
**/.git/**
**/.idea/**
**/target/**
**/storage/**
**/logs/**
**/*.log
**/*.pem
**/*.key
