# Copy to .env.local and fill the two required secrets. Do not commit .env.local.
DB_URL=jdbc:mysql://localhost:3308/language_center_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=
# Use one random value of at least 32 UTF-8 bytes for all four services.
JWT_SECRET=
JWT_EXPIRATION=86400000
DDL_AUTO=update
AUTH_URL=http://localhost:8081
ACADEMIC_URL=http://localhost:8082
TEACHING_URL=http://localhost:8083
FINANCE_URL=http://localhost:8084
# Optional one-time bootstrap; only runs when the accounts table is empty.
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=
