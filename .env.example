# Copy to .env.local and fill the two required secrets. Do not commit .env.local.
DB_URL=jdbc:mysql://localhost:3308/language_center_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=
# Use one random value of at least 32 UTF-8 bytes for all four services.
JWT_SECRET=
JWT_EXPIRATION=86400000
DDL_AUTO=update
AUTH_URL=http://localhost:8081
ACADEMIC_URL=http://localhost:8082
TEACHING_URL=http://localhost:8083
FINANCE_URL=http://localhost:8084
# Optional one-time bootstrap; only runs when the accounts table is empty.
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=

# G8: online payments remain unavailable until real sandbox merchant credentials
# and externally accessible HTTPS callback URLs are configured. Backend only.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_CHECKOUT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Server IP used in signed VNPAY querydr requests; set for your deployment.
VNPAY_SERVER_IP=127.0.0.1
VNPAY_TTL_MINUTES=15
PAYMENT_JOBS_ENABLED=true

# G9 inbox works without Expo/Firebase credentials.
NOTIFICATION_JOBS_ENABLED=true
NOTIFICATIONS_PUSH_ENABLED=false
EXPO_PROJECT_ID=
# Optional Expo enhanced push security token; backend only.
EXPO_PUSH_ACCESS_TOKEN=

# C4: private MCP + authenticated chat. Both disabled by default; key stays backend-only.
ASSISTANT_MCP_ENABLED=false
ASSISTANT_PORT=8086
ASSISTANT_CHAT_ENABLED=false
ASSISTANT_URL=http://localhost:8086
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=10
ASSISTANT_REQUESTS_PER_MINUTE=30
ASSISTANT_MODEL_CALLS_PER_MINUTE=12
ASSISTANT_GLOBAL_MODEL_CALLS_PER_MINUTE=120
ASSISTANT_CONCURRENT_PER_ACCOUNT=2
