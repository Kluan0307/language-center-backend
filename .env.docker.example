# Template only. Copy to .env.docker.local, fill values; do not use existing host .env.local unchanged.
# Compose uses its own mysql service. DB_URL below is for manual service runs.
IMAGE_TAG=local
CLOUDINARY_ENABLED=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=language-center/dev
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_HOST_PORT=18080
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_HOST_PORT=15173
WEBSITE_BIND_ADDRESS=127.0.0.1
WEBSITE_HOST_PORT=13000
WEBSITE_PUBLIC_URL=http://localhost:13000
WEBSITE_INDEXABLE=false
NEXT_PUBLIC_CENTER_PHONE=
NEXT_PUBLIC_CENTER_EMAIL=
MYSQL_ROOT_PASSWORD=
SPRING_PROFILES_ACTIVE=prod,docker
TZ=Asia/Ho_Chi_Minh
SERVER_ADDRESS=0.0.0.0
DB_URL=jdbc:mysql://mysql:3306/language_center_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=language_center_app
DB_PASSWORD=
DB_POOL_SIZE=5
JWT_SECRET=
JWT_EXPIRATION=28800000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:15173,http://127.0.0.1:15173,http://localhost:13000,http://127.0.0.1:13000
AUTH_URL=http://auth-service:8081
ACADEMIC_URL=http://academic-service:8082
TEACHING_URL=http://teaching-service:8083
FINANCE_URL=http://finance-service:8084
ASSISTANT_URL=http://assistant-service:8086
DOCUMENT_STORAGE=/app/data/documents
# Match Next.js private WEBSITE_FORM_SECRET; never prefix with NEXT_PUBLIC_.
WEBSITE_FORM_SECRET=
# Explicit opt-in for side effects; enable only when DCK3/DCK5 configuration is ready.
AUTH_BOOTSTRAP_ENABLED=false
ACADEMIC_SEED_BRANCHES_ENABLED=false
PAYMENT_JOBS_ENABLED=false
NOTIFICATION_JOBS_ENABLED=false
NOTIFICATIONS_PUSH_ENABLED=false
EXPO_PROJECT_ID=
EXPO_PUSH_ACCESS_TOKEN=
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_CHECKOUT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_SERVER_IP=127.0.0.1
VNPAY_TTL_MINUTES=15
ASSISTANT_CHAT_ENABLED=false
ASSISTANT_MCP_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=10
ASSISTANT_REQUESTS_PER_MINUTE=30
ASSISTANT_MODEL_CALLS_PER_MINUTE=12
ASSISTANT_GLOBAL_MODEL_CALLS_PER_MINUTE=120
ASSISTANT_CONCURRENT_PER_ACCOUNT=2
# Docker memory limits belong to Compose; keep this below the container memory limit.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Ho_Chi_Minh
