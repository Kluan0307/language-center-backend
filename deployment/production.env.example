# Copy outside the release directory; supply real values. This file is NOT a runnable secret file.
SPRING_PROFILES_ACTIVE=prod
SPRING_CONFIG_IMPORT=optional:file:/nonexistent-language-center-secrets.properties
DB_URL=jdbc:mysql://127.0.0.1:3306/language_center_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=language_center_app
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=28800000
CORS_ALLOWED_ORIGINS=https://language.example
SERVER_ADDRESS=127.0.0.1
AUTH_URL=http://127.0.0.1:8081
ACADEMIC_URL=http://127.0.0.1:8082
TEACHING_URL=http://127.0.0.1:8083
FINANCE_URL=http://127.0.0.1:8084
# Absolute persistent path, outside the release. Use forward slashes on Windows.
DOCUMENT_STORAGE=D:/language-center-data/documents
AUTH_BOOTSTRAP_ENABLED=false
